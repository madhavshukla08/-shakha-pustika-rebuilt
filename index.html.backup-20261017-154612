<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>शाखा पुस्तिका / Shakha Pustika</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Tiro+Devanagari+Hindi&family=Baloo+2:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://accounts.google.com/gsi/client" async defer></script>
<style>
  :root{
    --cream:#FBF5E9; --paper:#FFFDF8; --saffron:#C1440E; --saffron-deep:#96350A;
    --indigo:#20283F; --indigo-soft:#4A5471; --gold:#C9982E; --sage:#3F7A57; --sage-bg:#E7F1E9;
    --rose:#A8324A; --rose-bg:#F7E7E9; --line:#E6DAC4; --sidebar-text:#C7CEE3; --sidebar-hover:rgba(255,255,255,0.08);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  #srApp{ font-family:'Inter',sans-serif; background:var(--cream); color:var(--indigo); min-height:100vh; -webkit-font-smoothing:antialiased; }
  #srApp h1,#srApp h2,#srApp h3,.sr-devnag{font-family:'Tiro Devanagari Hindi','Baloo 2',serif;}
  .sr-shell{display:flex;min-height:100vh;position:relative;}
  .sr-sidebar{ width:232px;flex-shrink:0;background:var(--indigo);color:var(--sidebar-text); display:flex;flex-direction:column;padding:20px 14px; position:sticky;top:0;height:100vh;overflow-y:auto;z-index:30; }
  .sr-sidebar-close{display:none;}
  .sr-brand{display:flex;align-items:center;gap:10px;padding:4px 6px 14px;border-bottom:1px solid rgba(255,255,255,0.08);margin-bottom:14px;}
  .sr-brand-mark{width:36px;height:36px;border-radius:10px;background:var(--saffron);color:#fff;display:flex;align-items:center;justify-content:center;font-family:'Baloo 2',sans-serif;font-weight:700;font-size:17px;flex-shrink:0;}
  .sr-brand-title{font-family:'Tiro Devanagari Hindi',serif;font-size:16px;color:#fff;line-height:1.25;}
  .sr-brand-sub{font-size:10.5px;color:var(--sidebar-text);opacity:0.75;letter-spacing:0.3px;}
  .sr-lang-toggle{display:flex;background:rgba(255,255,255,0.08);border-radius:20px;padding:3px;margin-bottom:14px;}
  .sr-lang-toggle button{flex:1;border:none;background:transparent;padding:6px 10px;border-radius:18px;cursor:pointer;font-size:12.5px;font-weight:600;color:var(--sidebar-text);font-family:'Inter',sans-serif;transition:all .2s;}
  .sr-lang-toggle button.active{background:var(--saffron);color:#fff;}
  .sr-nav{display:flex;flex-direction:column;gap:3px;flex:1;}
  .sr-nav-item{ display:flex;align-items:center;gap:10px;text-align:left; background:none;border:none;color:var(--sidebar-text); padding:10px 12px;border-radius:9px;font-size:14px;font-weight:500; cursor:pointer;font-family:'Inter',sans-serif;width:100%; }
  .sr-nav-item span{font-family:'Tiro Devanagari Hindi','Inter',sans-serif;}
  .sr-nav-item:hover{background:var(--sidebar-hover);color:#fff;}
  .sr-nav-item.active{background:var(--saffron);color:#fff;}
  .sr-nav-item:focus-visible{outline:2px solid var(--gold);outline-offset:2px;}
  .sr-sidebar-bottom{margin-top:14px;padding-top:14px;border-top:1px solid rgba(255,255,255,0.08);font-size:12px;}
  .sr-head-box{display:flex;align-items:center;gap:9px;}
  .sr-head-label{font-size:10px;text-transform:uppercase;letter-spacing:0.4px;opacity:0.65;margin-bottom:5px;}
  .sr-head-name{color:#fff;font-weight:600;font-size:13px;}
  .sr-head-empty{font-size:12px;color:var(--sidebar-text);line-height:1.5;}
  .sr-head-link{color:var(--gold);text-decoration:underline;cursor:pointer;background:none;border:none;font-size:inherit;padding:0;font-family:'Inter',sans-serif;}
  .sr-org-box{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:10px 12px;margin-bottom:14px;font-size:12px;}
  .sr-org-row{display:flex;justify-content:space-between;gap:8px;padding:3px 0;color:var(--sidebar-text);}
  .sr-org-row b{color:#fff;font-weight:600;font-family:'Tiro Devanagari Hindi','Inter',sans-serif;text-align:right;}
  .sr-org-empty{color:var(--sidebar-text);opacity:0.75;line-height:1.5;}
  .sr-org-edit-link{color:var(--gold);text-decoration:underline;cursor:pointer;background:none;border:none;font-size:11.5px;padding:0;font-family:'Inter',sans-serif;margin-top:6px;display:inline-block;}
  .sr-org-form .sr-field{margin-bottom:8px;}
  .sr-org-form .sr-field label{color:var(--sidebar-text);font-size:10.5px;margin-bottom:3px;}
  .sr-org-form .sr-field input{padding:7px 9px;font-size:13px;}
  .sr-org-form-actions{display:flex;gap:8px;margin-top:4px;}
  .sr-org-form-actions .sr-btn{padding:7px 12px;font-size:12.5px;}
  .sr-overlay{display:none;position:fixed;inset:0;background:rgba(20,24,38,0.5);z-index:25;}
  .sr-overlay.show{display:block;}
  .sr-main{flex:1;min-width:0;}
  .sr-topbar{ display:none;align-items:center;gap:12px;background:var(--paper); border-bottom:1px solid var(--line);padding:14px 16px;position:sticky;top:0;z-index:20; }
  .sr-hamburger{background:none;border:1px solid var(--line);border-radius:8px;width:36px;height:36px;font-size:16px;cursor:pointer;color:var(--indigo);flex-shrink:0;}
  .sr-topbar-title{font-family:'Tiro Devanagari Hindi',serif;font-size:16px;font-weight:600;}
  .sr-content{max-width:820px;margin:0 auto;padding:26px 22px 60px;}
  @media (max-width:820px){
    .sr-sidebar{position:fixed;left:0;top:0;transform:translateX(-100%);transition:transform .2s ease;box-shadow:6px 0 24px rgba(0,0,0,0.18);}
    .sr-sidebar.open{transform:translateX(0);}
    .sr-sidebar-close{display:block;position:absolute;top:14px;right:14px;color:#fff;opacity:0.7;cursor:pointer;font-size:16px;background:none;border:none;}
    .sr-topbar{display:flex;}
    .sr-content{padding:20px 16px 50px;}
  }
  .sr-card{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:18px;margin-bottom:16px;box-shadow:0 1px 3px rgba(32,40,63,0.05);}
  .sr-card h2{font-size:18px;margin:0 0 14px;color:var(--indigo);}
  .sr-field{margin-bottom:12px;}
  .sr-field label{display:block;font-size:12px;font-weight:600;color:var(--indigo-soft);margin-bottom:5px;text-transform:uppercase;letter-spacing:0.4px;}
  .sr-field input,.sr-field select,.sr-field textarea{ width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:9px; font-size:14.5px;font-family:'Inter',sans-serif;background:#fff;color:var(--indigo); }
  .sr-field textarea{resize:vertical;min-height:64px;}
  .sr-field input:focus-visible,.sr-field select:focus-visible,.sr-field textarea:focus-visible{outline:2px solid var(--gold);outline-offset:1px;border-color:var(--gold);}
  .sr-row2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  @media (max-width:480px){.sr-row2{grid-template-columns:1fr;}}
  .sr-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;background:var(--saffron);color:#fff;border:none;padding:11px 18px;border-radius:9px;font-weight:600;font-size:14px;cursor:pointer;font-family:'Inter',sans-serif;}
  .sr-btn:hover{background:var(--saffron-deep);}
  .sr-btn:focus-visible{outline:2px solid var(--gold);outline-offset:2px;}
  .sr-btn.secondary{background:transparent;color:var(--indigo-soft);border:1px solid var(--line);}
  .sr-btn.secondary:hover{background:#f3ede0;}
  .sr-btn:disabled{opacity:0.55;cursor:not-allowed;}
  .sr-member{display:flex;align-items:center;gap:12px;padding:12px 4px;border-bottom:1px solid var(--line);}
  .sr-member:last-child{border-bottom:none;}
  .sr-avatar{width:38px;height:38px;border-radius:50%;background:var(--indigo);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;flex-shrink:0;font-family:'Baloo 2',sans-serif;}
  .sr-member-info{flex:1;min-width:0;}
  .sr-member-name{font-weight:600;font-size:14.5px;color:var(--indigo);}
  .sr-member-meta{font-size:12.5px;color:var(--indigo-soft);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .sr-member-actions{display:flex;gap:6px;flex-shrink:0;}
  .sr-icon-btn{background:none;border:1px solid var(--line);border-radius:7px;width:30px;height:30px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--indigo-soft);flex-shrink:0;}
  .sr-icon-btn:hover{background:#f3ede0;}
  .sr-icon-btn:focus-visible{outline:2px solid var(--gold);}
  .sr-star-btn{background:none;border:1px solid var(--line);border-radius:7px;width:30px;height:30px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--gold);font-size:15px;flex-shrink:0;}
  .sr-star-btn.on{background:#FBF0D9;border-color:var(--gold);}
  .sr-star-btn:hover{background:#f3ede0;}
  .sr-badge-head{font-size:10.5px;font-weight:700;color:var(--saffron-deep);background:#FCE7D9;padding:2px 8px;border-radius:20px;margin-left:6px;vertical-align:middle;}
  .sr-empty{text-align:center;padding:32px 12px;color:var(--indigo-soft);font-size:14px;line-height:1.6;}
  .sr-empty-glyph{font-size:30px;margin-bottom:8px;opacity:0.6;}
  .sr-att-top{display:flex;align-items:center;gap:16px;flex-wrap:wrap;justify-content:space-between;}
  .sr-date-input{padding:9px 12px;border:1px solid var(--line);border-radius:9px;font-size:14px;font-family:'Inter',sans-serif;background:#fff;color:var(--indigo);}
  .sr-ring-wrap{display:flex;align-items:center;gap:10px;}
  .sr-ring-label{font-size:12px;color:var(--indigo-soft);line-height:1.3;}
  .sr-ring-label b{color:var(--indigo);font-size:15px;display:block;}
  .sr-att-row{display:flex;align-items:center;gap:12px;padding:11px 4px;border-bottom:1px solid var(--line);}
  .sr-att-row:last-child{border-bottom:none;}
  .sr-toggle{display:flex;flex-wrap:wrap;border:1px solid var(--line);border-radius:8px;overflow:hidden;flex-shrink:0;}
  .sr-toggle button{border:none;background:#fff;padding:7px 10px;font-size:12.5px;font-weight:600;cursor:pointer;color:var(--indigo-soft);font-family:'Inter',sans-serif;}
  .sr-toggle button.present.on{background:var(--sage);color:#fff;}
  .sr-toggle button.absent.on{background:var(--rose);color:#fff;}
  .sr-toggle button.pravas.on{background:var(--gold);color:#fff;}
  .sr-toggle button.anya.on{background:var(--indigo-soft);color:#fff;}
  .sr-toggle button:focus-visible{outline:2px solid var(--gold);outline-offset:-2px;}
  .sr-history-item{display:flex;justify-content:space-between;align-items:center;padding:10px 4px;border-bottom:1px solid var(--line);font-size:13.5px;cursor:pointer;background:none;border-left:none;border-right:none;border-top:none;width:100%;text-align:left;color:var(--indigo);font-family:'Inter',sans-serif;}
  .sr-history-item:last-child{border-bottom:none;}
  .sr-history-item:hover{background:#f8f2e4;}
  .sr-history-badge{font-size:11.5px;font-weight:700;padding:3px 9px;border-radius:20px;background:var(--sage-bg);color:var(--sage);white-space:nowrap;}
  .sr-note{font-size:12px;color:var(--indigo-soft);margin:6px 4px 0;line-height:1.6;}
  .sr-type-tag{font-size:11px;font-weight:600;padding:2px 9px;border-radius:20px;background:var(--sage-bg);color:var(--sage);display:inline-block;margin-top:3px;}
  .sr-subh-card{padding:14px 4px;border-bottom:1px solid var(--line);}
  .sr-subh-card:last-child{border-bottom:none;}
  .sr-subh-sanskrit{font-family:'Tiro Devanagari Hindi',serif;font-size:16px;color:var(--indigo);line-height:1.65;margin-bottom:6px;white-space:pre-line;}
  .sr-subh-meaning{font-size:13.5px;color:var(--indigo-soft);line-height:1.55;white-space:pre-line;}
  .sr-subh-source{font-size:11.5px;color:var(--gold);margin-top:6px;font-weight:600;}
  .sr-subh-actions{display:flex;gap:6px;margin-top:9px;}
  .sr-amrit-card{padding:14px 4px;border-bottom:1px solid var(--line);}
  .sr-amrit-card:last-child{border-bottom:none;}
  .sr-amrit-text{font-size:14.5px;color:var(--indigo);line-height:1.6;white-space:pre-line;font-weight:500;}
  .sr-amrit-author{font-size:12px;color:var(--saffron-deep);margin-top:7px;font-weight:700;}
  .sr-amrit-context{font-size:12px;color:var(--indigo-soft);margin-top:3px;line-height:1.5;}
  .sr-amrit-actions{display:flex;gap:6px;margin-top:9px;}
  .sr-amrit-spot{background:linear-gradient(135deg,#F7E7E9 0%,#F2D6DA 100%);border:1px solid var(--rose);border-radius:14px;padding:16px;}
  .sr-dash-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;}
  @media (max-width:520px){.sr-dash-grid{grid-template-columns:1fr;}}
  .sr-nav-card{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:16px;cursor:pointer;text-align:left;width:100%;font-family:'Inter',sans-serif;display:flex;align-items:center;gap:12px;}
  .sr-nav-card:hover{border-color:var(--gold);}
  .sr-nav-card:focus-visible{outline:2px solid var(--gold);outline-offset:2px;}
  .sr-nav-card-icon{font-size:22px;flex-shrink:0;}
  .sr-nav-card-title{font-weight:700;font-size:14.5px;color:var(--indigo);font-family:'Baloo 2',sans-serif;}
  .sr-nav-card-sub{font-size:12px;color:var(--indigo-soft);margin-top:1px;}
  .sr-spotlight{background:linear-gradient(135deg,#FFF8EA 0%,#FBF0D9 100%);border:1px solid var(--gold);border-radius:14px;padding:18px;}
  .sr-spotlight-label{font-size:11px;text-transform:uppercase;letter-spacing:0.5px;color:var(--saffron-deep);font-weight:700;margin-bottom:9px;}
  .sr-ganvesh-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  @media (max-width:560px){.sr-ganvesh-grid{grid-template-columns:1fr;}}
  .sr-ganvesh-item{border:1px solid var(--line);border-radius:12px;padding:14px;background:#fff;}
  .sr-ganvesh-item h3{margin:0 0 8px;font-size:14.5px;color:var(--saffron-deep);}
  .sr-ganvesh-item ul{margin:0;padding-left:18px;font-size:13.5px;color:var(--indigo-soft);line-height:1.7;}
  .sr-founder-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  @media (max-width:560px){.sr-founder-grid{grid-template-columns:1fr;}}
  .sr-founder-card{text-align:center;border:1px solid var(--line);border-radius:14px;padding:16px 12px;background:#fff;}
  .sr-founder-photo{width:120px;height:150px;object-fit:cover;border-radius:10px;border:2px solid var(--gold);margin-bottom:10px;background:#f3ede0;}
  .sr-founder-name{font-weight:700;font-size:14.5px;color:var(--indigo);font-family:'Baloo 2',sans-serif;}
  .sr-founder-role{font-size:12px;color:var(--saffron-deep);font-weight:600;margin:3px 0 6px;}
  .sr-founder-desc{font-size:12.5px;color:var(--indigo-soft);line-height:1.6;}
  .sr-toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--indigo);color:#fff;padding:10px 20px;border-radius:20px;font-size:13.5px;font-weight:500;box-shadow:0 4px 14px rgba(0,0,0,0.2);z-index:50;opacity:0;pointer-events:none;transition:opacity .2s ease,transform .2s ease;}
  .sr-toast.show{opacity:1;transform:translateX(-50%) translateY(-4px);}
  .sr-loading{text-align:center;padding:40px;color:var(--indigo-soft);}

  /* ---------- Login gate ---------- */
  #srLoginGate{ font-family:'Inter',sans-serif; background:var(--cream); color:var(--indigo); min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px; -webkit-font-smoothing:antialiased; }
  #srLoginGate h1,#srLoginGate .ln-devnag{font-family:'Tiro Devanagari Hindi','Baloo 2',serif;}
  .ln-card{ background:var(--paper); border:1px solid var(--line); border-radius:16px; box-shadow:0 4px 18px rgba(32,40,63,0.08); padding:32px 28px; width:100%; max-width:380px; }
  .ln-brand{display:flex;align-items:center;gap:10px;margin-bottom:22px;}
  .ln-brand-mark{width:44px;height:44px;border-radius:12px;background:var(--saffron);color:#fff;display:flex;align-items:center;justify-content:center;font-family:'Baloo 2',sans-serif;font-weight:700;font-size:20px;flex-shrink:0;}
  .ln-brand-title{font-size:18px;line-height:1.25;color:var(--indigo);}
  .ln-brand-sub{font-size:11px;color:var(--indigo-soft);letter-spacing:0.3px;margin-top:1px;}
  .ln-lang-toggle{display:flex;background:#f3ede0;border-radius:20px;padding:3px;margin-bottom:22px;}
  .ln-lang-toggle button{flex:1;border:none;background:transparent;padding:6px 10px;border-radius:18px;cursor:pointer;font-size:12.5px;font-weight:600;color:var(--indigo-soft);font-family:'Inter',sans-serif;transition:all .2s;}
  .ln-lang-toggle button.active{background:var(--saffron);color:#fff;}
  .ln-title{font-size:21px;margin:0 0 4px;color:var(--indigo);}
  .ln-subtitle{font-size:13px;color:var(--indigo-soft);margin:0 0 22px;}
  .ln-field{margin-bottom:14px;}
  .ln-field label{display:block;font-size:12px;font-weight:600;color:var(--indigo-soft);margin-bottom:5px;text-transform:uppercase;letter-spacing:0.4px;}
  .ln-field input{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:9px;font-size:14.5px;font-family:'Inter',sans-serif;background:#fff;color:var(--indigo);}
  .ln-field input:focus-visible{outline:2px solid var(--gold);outline-offset:1px;border-color:var(--gold);}
  .ln-pass-wrap{position:relative;}
  .ln-pass-wrap input{padding-right:44px;}
  .ln-pass-toggle{position:absolute;right:4px;top:4px;bottom:4px;width:36px;background:none;border:none;cursor:pointer;color:var(--indigo-soft);font-size:13px;}
  .ln-row-between{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;font-size:12.5px;}
  .ln-remember{display:flex;align-items:center;gap:6px;color:var(--indigo-soft);}
  .ln-remember input{width:14px;height:14px;}
  .ln-link{color:var(--saffron);text-decoration:none;font-weight:600;cursor:pointer;background:none;border:none;font-size:12.5px;font-family:'Inter',sans-serif;padding:0;}
  .ln-link:hover{text-decoration:underline;}
  .ln-btn{width:100%;display:flex;align-items:center;justify-content:center;gap:6px;background:var(--saffron);color:#fff;border:none;padding:12px 18px;border-radius:9px;font-weight:600;font-size:14.5px;cursor:pointer;font-family:'Inter',sans-serif;}
  .ln-btn:hover{background:var(--saffron-deep);}
  .ln-btn:disabled{opacity:0.6;cursor:not-allowed;}
  .ln-error{background:var(--rose-bg);color:var(--rose);border:1px solid #eeccd2;border-radius:9px;padding:9px 12px;font-size:12.5px;margin-bottom:14px;display:none;}
  .ln-error.show{display:block;}
  .ln-divider{display:flex;align-items:center;gap:10px;margin:18px 0;color:var(--indigo-soft);font-size:12px;}
  .ln-divider::before,.ln-divider::after{content:"";flex:1;height:1px;background:var(--line);}
  .ln-google-btn{width:100%;display:flex;align-items:center;justify-content:center;gap:10px;background:#fff;color:var(--indigo);border:1px solid var(--line);padding:11px 18px;border-radius:9px;font-weight:600;font-size:14.5px;cursor:pointer;font-family:'Inter',sans-serif;margin-bottom:6px;}
  .ln-google-btn:hover{background:#f7f3e9;}
  .ln-google-btn svg{width:18px;height:18px;flex-shrink:0;}
  #lnGoogleReal{display:flex;justify-content:center;margin-bottom:6px;}
  .ln-footer{text-align:center;margin-top:18px;font-size:12.5px;color:var(--indigo-soft);}
  .sr-logout-btn{background:none;border:1px solid rgba(255,255,255,0.15);color:var(--sidebar-text);border-radius:8px;padding:6px 10px;font-size:11.5px;cursor:pointer;font-family:'Inter',sans-serif;}
  .sr-logout-btn:hover{background:rgba(255,255,255,0.08);}
</style>
</head>
<body>
<div id="srLoginGate">
  <div class="ln-card">
    <div class="ln-brand">
      <div class="ln-brand-mark">श</div>
      <div>
        <div class="ln-brand-title ln-devnag" id="lnBrandTitle">शाखा पुस्तिका</div>
        <div class="ln-brand-sub" id="lnBrandSub">Shakha Pustika</div>
      </div>
    </div>

    <div class="ln-lang-toggle">
      <button id="lnLangHi" class="active" onclick="srLoginSetLang('hi')">हिंदी</button>
      <button id="lnLangEn" onclick="srLoginSetLang('en')">English</button>
    </div>

    <h1 class="ln-title" id="lnTitle">प्रवेश करें</h1>
    <p class="ln-subtitle" id="lnSubtitle">अपनी शाखा में लॉगिन करें</p>

    <div class="ln-error" id="lnError"></div>

    <form id="lnForm">
      <div class="ln-field">
        <label id="lnLabelUser">स्वयंसेवक का नाम / फोन नंबर</label>
        <input type="text" id="lnUser" autocomplete="username" required>
      </div>
