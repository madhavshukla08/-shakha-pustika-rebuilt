<script>
(function(){
  // ==================== LOGIN GATE ====================
  const LT = {
    hi:{
      title:'प्रवेश करें', subtitle:'अपनी शाखा में लॉगिन करें',
      labelUser:'स्वयंसेवक का नाम / फोन नंबर', labelPass:'पासकोड',
      remember:'मुझे याद रखें', forgot:'पासकोड भूल गए?', submit:'प्रवेश करें',
      submitting:'प्रवेश हो रहा है…', registerPrompt:'पहली बार यहाँ?', registerLink:'खाता बनाएं',
      show:'देखें', hide:'छिपाएं',
      errRequired:'कृपया नाम और पासकोड दोनों भरें।',
      errInvalid:'नाम या पासकोड गलत है। पुनः प्रयास करें।',
      welcomeToast:'स्वागत है',
      forgotToast:'कृपया अपने शाखा प्रमुख से संपर्क करें।',
      registerToast:'नया खाता बनाने के लिए अपने शाखा प्रमुख से संपर्क करें।',
      divider:'या', googleBtn:'Google से जारी रखें',
      googleNotConfigured:'Google लॉगिन अभी सेट नहीं है। साइट व्यवस्थापक को अपना Google Client ID जोड़ने दें।',
      logout:'लॉग आउट'
    },
    en:{
      title:'Sign in', subtitle:'Log in to your shakha',
      labelUser:'Volunteer name / phone number', labelPass:'Passcode',
      remember:'Remember me', forgot:'Forgot passcode?', submit:'Sign in',
      submitting:'Signing in…', registerPrompt:'First time here?', registerLink:'Create an account',
      show:'Show', hide:'Hide',
      errRequired:'Please enter both name and passcode.',
      errInvalid:'Incorrect name or passcode. Please try again.',
      welcomeToast:'Welcome',
      forgotToast:'Please contact your shakha head to reset your passcode.',
      registerToast:'Please contact your shakha head to set up a new account.',
      divider:'or', googleBtn:'Continue with Google',
      googleNotConfigured:'Google sign-in isn\'t configured yet. Ask the site admin to add a Google Client ID.',
      logout:'Log out'
    }
  };
  let lnLang = 'hi';
  function ltr(){ return LT[lnLang]; }

  window.srLoginSetLang = function(l){
    lnLang = l;
    document.getElementById('lnLangHi').classList.toggle('active', l==='hi');
    document.getElementById('lnLangEn').classList.toggle('active', l==='en');
    document.getElementById('lnTitle').textContent = ltr().title;
    document.getElementById('lnSubtitle').textContent = ltr().subtitle;
    document.getElementById('lnLabelUser').textContent = ltr().labelUser;
    document.getElementById('lnLabelPass').textContent = ltr().labelPass;
    document.getElementById('lnRememberText').textContent = ltr().remember;
    document.getElementById('lnForgot').textContent = ltr().forgot;
    document.getElementById('lnSubmit').textContent = ltr().submit;
    document.getElementById('lnRegisterLink').textContent = ltr().registerLink;
    document.getElementById('lnDivider').textContent = ltr().divider;
    document.getElementById('lnGoogleText').textContent = ltr().googleBtn;
    document.getElementById('lnPassToggle').textContent =
      document.getElementById('lnPass').type === 'password' ? ltr().show : ltr().hide;
    const footer = document.getElementById('lnFooter');
    footer.childNodes[0].textContent = ltr().registerPrompt + ' ';
    const logoutBtn = document.getElementById('srLogoutBtn');
    if(logoutBtn) logoutBtn.textContent = ltr().logout;
    lnHideError();
  };

  window.srLoginTogglePass = function(){
    const input = document.getElementById('lnPass');
    const btn = document.getElementById('lnPassToggle');
    if(input.type === 'password'){ input.type = 'text'; btn.textContent = ltr().hide; }
    else { input.type = 'password'; btn.textContent = ltr().show; }
  };

  function lnShowError(msg){
    const el = document.getElementById('lnError');
    el.textContent = msg;
    el.classList.add('show');
  }
  function lnHideError(){
    document.getElementById('lnError').classList.remove('show');
  }
  function lnToast(msg){
    const el = document.getElementById('lnToast');
    el.textContent = msg;
    el.style.opacity = '1';
    el.style.transform = 'translateX(-50%) translateY(0)';
    setTimeout(()=>{ el.style.opacity = '0'; el.style.transform = 'translateX(-50%) translateY(20px)'; }, 2400);
  }

  const SESSION_KEY = 'shakhaPustika:session';

  function showApp(){
    document.getElementById('srLoginGate').style.display = 'none';
    document.getElementById('srApp').style.display = '';
  }
  function showGate(){
    document.getElementById('srApp').style.display = 'none';
    document.getElementById('srLoginGate').style.display = 'flex';
  }

  window.srDoLogout = function(){
    try{ localStorage.removeItem(SESSION_KEY); sessionStorage.removeItem(SESSION_KEY); }catch(e){}
    showGate();
  };

  // If a session already exists, skip straight to the app.
  (function checkExistingSession(){
    try{
      const raw = localStorage.getItem(SESSION_KEY) || sessionStorage.getItem(SESSION_KEY);
      if(raw){ showApp(); }
    }catch(e){ /* ignore */ }
  })();

  // ---------- Storage-backed demo auth ----------
  // NOTE: plain-text passcodes are fine for this demo/login-UI, but in a real
  // deployment credentials must be verified against a proper backend, never
  // checked client-side like this.
  const hasCloudStorage = (typeof window !== 'undefined' && window.storage && typeof window.storage.get === 'function');
  async function lnGetUsers(){
    try{
      if(hasCloudStorage){
        const r = await window.storage.get('authUsers', true);
        return r ? JSON.parse(r.value) : [];
      }
      const raw = localStorage.getItem('shakhaPustika:authUsers');
      return raw ? JSON.parse(raw) : [];
    }catch(e){ return []; }
  }
  async function lnSaveUsers(users){
    try{
      if(hasCloudStorage){ await window.storage.set('authUsers', JSON.stringify(users), true); return; }
      localStorage.setItem('shakhaPustika:authUsers', JSON.stringify(users));
    }catch(e){ /* ignore */ }
  }
  async function lnSeedDemoUserIfEmpty(){
    const users = await lnGetUsers();
    if(users.length === 0){ await lnSaveUsers([{ name:'demo', pass:'demo123' }]); }
  }
  lnSeedDemoUserIfEmpty();

  document.getElementById('lnForm').addEventListener('submit', async function(e){
    e.preventDefault();
    lnHideError();
    const nameInput = document.getElementById('lnUser').value.trim();
    const passInput = document.getElementById('lnPass').value;
    if(!nameInput || !passInput){ lnShowError(ltr().errRequired); return; }

    const btn = document.getElementById('lnSubmit');
    btn.disabled = true;
    btn.textContent = ltr().submitting;

    const users = await lnGetUsers();
    const match = users.find(u => u.name.toLowerCase() === nameInput.toLowerCase() && u.pass === passInput);

    btn.disabled = false;
    btn.textContent = ltr().submit;

    if(match){
      const remember = document.getElementById('lnRemember').checked;
      try{
        const storageArea = remember ? localStorage : sessionStorage;
        storageArea.setItem(SESSION_KEY, JSON.stringify({ name: match.name, at: Date.now() }));
      }catch(e){ /* ignore */ }
      lnToast(ltr().welcomeToast + ', ' + match.name);
      showApp();
    } else {
      lnShowError(ltr().errInvalid);
    }
  });

  window.srLoginForgot = function(){ lnToast(ltr().forgotToast); };
  window.srLoginRegister = function(){ lnToast(ltr().registerToast); };

  // ---------- Google Sign-In ----------
  // 1. Go to https://console.cloud.google.com/apis/credentials
  // 2. Create an "OAuth client ID" of type "Web application"
  // 3. Add this page's exact hosted URL under "Authorized JavaScript origins"
  // 4. Paste the client ID below (looks like xxxx.apps.googleusercontent.com)
  const GOOGLE_CLIENT_ID = 'YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com';
  const googleConfigured = GOOGLE_CLIENT_ID && GOOGLE_CLIENT_ID.indexOf('YOUR_GOOGLE_CLIENT_ID') === -1;

  function lnDecodeJwt(token){
    try{
      const base64 = token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/');
      const json = decodeURIComponent(atob(base64).split('').map(c =>
        '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join(''));
      return JSON.parse(json);
    }catch(e){ return null; }
  }

  async function lnHandleGoogleCredential(response){
    const payload = lnDecodeJwt(response.credential);
    if(!payload) return;
    const remember = document.getElementById('lnRemember').checked;
    try{
      const storageArea = remember ? localStorage : sessionStorage;
      storageArea.setItem(SESSION_KEY, JSON.stringify({
        name: payload.name, email: payload.email, picture: payload.picture,
        provider: 'google', at: Date.now()
      }));
    }catch(e){ /* ignore */ }
    lnToast(ltr().welcomeToast + ', ' + payload.name);
    showApp();
  }

  window.srLoginGoogleFallback = function(){ lnToast(ltr().googleNotConfigured); };

  function lnInitGoogle(){
    if(!googleConfigured || typeof google === 'undefined' || !google.accounts) return;
    document.getElementById('lnGoogleFallback').style.display = 'none';
    google.accounts.id.initialize({ client_id: GOOGLE_CLIENT_ID, callback: lnHandleGoogleCredential });
    google.accounts.id.renderButton(document.getElementById('lnGoogleReal'), {
      theme: 'outline', size: 'large', width: 328, shape: 'rectangular'
    });
  }
  let lnGoogleCheckAttempts = 0;
  const lnGoogleCheckInterval = setInterval(function(){
    lnGoogleCheckAttempts++;
    if(typeof google !== 'undefined' && google.accounts){
      clearInterval(lnGoogleCheckInterval);
      lnInitGoogle();
    } else if(lnGoogleCheckAttempts > 20){
      clearInterval(lnGoogleCheckInterval);
    }
  }, 250);
  // ==================== END LOGIN GATE ====================
})();
</script>

