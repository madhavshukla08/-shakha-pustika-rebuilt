  async function seedDefaultsIfEmpty(){
    // Games: additive by name, so re-running after an update adds newly introduced games
    // without duplicating ones already saved/edited by the user.
    const existingGameNames = new Set(state.games.map(g=>g.name));
    let gamesChanged = false;
    for(const g of seedGames){
      if(!existingGameNames.has(g.name)){
        state.games.push({ id: uid('g'), ...g });
        existingGameNames.add(g.name);
        gamesChanged = true;
      }
    }
    if(gamesChanged) await saveList('games', state.games);

    if(state.subhashitam.length===0){
      state.subhashitam = seedSubhashitam.map(s=>({ id: uid('s'), ...s }));
      await saveList('subhashitam', state.subhashitam);
    }

    if(state.amritvachan.length===0){
      state.amritvachan = seedAmritVachan.map(a=>({ id: uid('av'), ...a }));
      await saveList('amritvachan', state.amritvachan);
    }
  }

  // ---------- Wiring ----------
  document.getElementById('srHamburger').addEventListener('click', openMobileSidebar);
  document.getElementById('srSidebarClose').addEventListener('click', closeMobileSidebar);
  overlayEl.addEventListener('click', closeMobileSidebar);

  // ---------- Init ----------
  (async function init(){
    try{
      buildNav();
      state.members = await loadList('members');
      state.games = await loadList('games');
      state.subhashitam = await loadList('subhashitam');
      state.amritvachan = await loadList('amritvachan');
      state.pravas = await loadList('pravas');
      await seedDefaultsIfEmpty();
      await loadSettings();
      updateSidebarHead();
      updateSidebarOrgBox();
      await goToPage('dashboard');
    }catch(err){
      contentEl.innerHTML = emptyBlock('⚠️','Problem loading data. Please reload the page. / डेटा लोड करने में समस्या हुई। कृपया पेज रीलोड करें।');
    }
  })();
})();
</script>
