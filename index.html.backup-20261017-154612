  async function onSubmitMember(e){
    e.preventDefault();
    const name = document.getElementById('srName').value.trim();
    const dayitva = document.getElementById('srDayitva').value.trim();
    const mobile = document.getElementById('srMobile').value.trim();
    const address = document.getElementById('srAddress').value.trim();
    const shikshan = Array.from(document.querySelectorAll('[data-shikshan]:checked')).map(el=>el.getAttribute('data-shikshan'));
    if(!name) return;
    const L = tr().toast;
    if(state.editingMemberId){
      const m = state.members.find(x=>x.id===state.editingMemberId);
      if(m){ m.name=name; m.dayitva=dayitva; m.mobile=mobile; m.address=address; m.shikshan=shikshan; }
      state.editingMemberId = null;
      toast(L.memberUpdated);
    }else{
      state.members.push({ id: uid('m'), name, dayitva, mobile, address, shikshan });
      toast(L.memberAdded);
    }
    renderMembers();
    updateSidebarHead();
    await saveList('members', state.members);
  }

  async function onDeleteMember(id){
    const m = state.members.find(x=>x.id===id);
    if(!m) return;
    if(!confirm(tr().confirm.delMember(m.name))) return;
    state.members = state.members.filter(x=>x.id!==id);
    if(state.settings.headMemberId===id){ state.settings.headMemberId=null; await saveSettings(); }
    renderMembers();
    updateSidebarHead();
    await saveList('members', state.members);
    toast(tr().toast.memberDeleted);
  }

