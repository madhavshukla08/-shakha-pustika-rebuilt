  function todayStr(){
    const d = new Date();
    const off = d.getTimezoneOffset();
    const local = new Date(d.getTime() - off*60000);
    return local.toISOString().slice(0,10);
  }
  function esc(s){ return (s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
  function initials(name){ const p = (name||'').trim().split(/\s+/); return ((p[0]||'')[0] + (p[1]?p[1][0]:'')).toUpperCase() || '?'; }
  function uid(prefix){ return prefix + Date.now() + Math.random().toString(36).slice(2,7); }
  function truncate(s,n){ s=s||''; return s.length>n ? s.slice(0,n-1)+'…' : s; }
  function toast(msg){ toastEl.textContent = msg; toastEl.classList.add('show'); setTimeout(()=>toastEl.classList.remove('show'), 2200); }
  function emptyBlock(glyph, html){ return `<div class="sr-empty"><div class="sr-empty-glyph">${glyph}</div>${html}</div>`; }
  function formatDate(dstr){
    const [y,m,d] = dstr.split('-');
    return `${parseInt(d)} ${tr().months[parseInt(m)-1]} ${y}`;
  }
  // maps stored (Hindi) game type value -> localized label
  const typeMapHiToEn = { 'शारीरिक':'Physical', 'बौद्धिक':'Intellectual', 'सामूहिक':'Group', 'अन्य':'Other' };
  function typeLabel(hiType){
    if(!hiType) return '';
    return state.lang==='en' ? (typeMapHiToEn[hiType]||hiType) : hiType;
  }
  // Normalizes an attendance value to one of: 'present' | 'absent' | 'pravas' | 'anya' | null
  // (also supports legacy boolean values true/false saved before status options were added)
  function attStatus(v){
    if(v===true) return 'present';
    if(v===false) return 'absent';
    return v || null;
  }
  function ringSvg(percent){
    const r=24, c=2*Math.PI*r, off=c-(percent/100)*c;
    const color = percent>=70?'var(--sage)':percent>=40?'var(--gold)':'var(--rose)';
    return `<svg width="60" height="60" viewBox="0 0 60 60">
      <circle cx="30" cy="30" r="${r}" fill="none" stroke="var(--line)" stroke-width="6"/>
      <circle cx="30" cy="30" r="${r}" fill="none" stroke="${color}" stroke-width="6" stroke-dasharray="${c}" stroke-dashoffset="${off}" stroke-linecap="round" transform="rotate(-90 30 30)"/>
      <text x="30" y="34" text-anchor="middle" font-size="13" font-weight="700" fill="var(--indigo)" font-family="Inter,sans-serif">${percent}%</text>
    </svg>`;
  }

  // ---------- Storage ----------
  // Uses window.storage when available (Claude.ai chat/artifact view).
  // Falls back to the browser's localStorage when this file is opened directly
  // (e.g. downloaded and double-clicked, or hosted on your own site), so data
  // is still saved on that device/browser.
  const LS_PREFIX = 'shakhaPustika:';
  const hasCloudStorage = (typeof window !== 'undefined' && window.storage && typeof window.storage.get === 'function');
  const store = {
    async get(key){
      if(hasCloudStorage){
        try{ return await window.storage.get(key, true); }
        catch(e){ /* fall through to local */ }
      }
      try{
        const raw = localStorage.getItem(LS_PREFIX+key);
        return raw===null ? null : { key, value: raw, shared:false };
      }catch(e){ return null; }
    },
    async set(key, value){
      if(hasCloudStorage){
        try{ const r = await window.storage.set(key, value, true); if(r) return r; }
        catch(e){ /* fall through to local */ }
      }
      try{ localStorage.setItem(LS_PREFIX+key, value); return { key, value, shared:false }; }
      catch(e){ return null; }
    },
    async list(prefix){
      if(hasCloudStorage){
        try{ return await window.storage.list(prefix, true); }
        catch(e){ /* fall through to local */ }
      }
      try{
        const keys = [];
        for(let i=0;i<localStorage.length;i++){
          const k = localStorage.key(i);
          if(k && k.indexOf(LS_PREFIX)===0){
            const bare = k.slice(LS_PREFIX.length);
            if(!prefix || bare.indexOf(prefix)===0) keys.push(bare);
          }
        }
        return { keys, prefix, shared:false };
      }catch(e){ return { keys:[], prefix, shared:false }; }
    }
  };
  async function loadList(key){
    try{ const r = await store.get(key); return r ? JSON.parse(r.value) : []; }
    catch(e){ return []; }
  }
  async function saveList(key, arr){
    try{ const r = await store.set(key, JSON.stringify(arr)); if(!r) toast(tr().toast.saveErr); }
    catch(e){ toast(tr().toast.saveErr); }
  }
  async function loadSettings(){
    const fallback = { headMemberId:null, prant:'', mahanagar:'', nagar:'', gatKramank:'', mandal:'', shakha:'' };
    try{
      const r = await store.get('settings');
      state.settings = r ? Object.assign({}, fallback, JSON.parse(r.value)) : fallback;
    }
    catch(e){ state.settings = fallback; }
    // migrate old combined "mahanagarNagar" field (pre-split) into "nagar" if new fields are empty
    if(state.settings.mahanagarNagar && !state.settings.mahanagar && !state.settings.nagar){
      state.settings.nagar = state.settings.mahanagarNagar;
    }
  }
  async function saveSettings(){
    try{ const r = await store.set('settings', JSON.stringify(state.settings)); if(!r) toast(tr().toast.saveErr); }
    catch(e){ toast(tr().toast.saveErr); }
  }
  async function fetchAttendanceRecord(date){
    try{
      const r = await store.get('attendance:'+date);
      if(!r) return { presence:{}, gameId:null, subhashitamId:null };
      const parsed = JSON.parse(r.value);
      if(parsed && parsed.presence) return { presence:parsed.presence||{}, gameId:parsed.gameId||null, subhashitamId:parsed.subhashitamId||null };
      return { presence: parsed||{}, gameId:null, subhashitamId:null };
    }catch(e){ return { presence:{}, gameId:null, subhashitamId:null }; }
  }
  async function saveAttendanceRecord(date, record){
    try{ const r = await store.set('attendance:'+date, JSON.stringify(record)); return !!r; }
    catch(e){ return false; }
  }
  async function loadHistoryDates(){
    try{
      const r = await store.list('attendance:');
      state.historyDates = (r && r.keys ? r.keys : []).map(k=>k.replace('attendance:','')).sort().reverse();
    }catch(e){ state.historyDates = []; }
  }

  // ---------- Language ----------
  function setLang(l){
    state.lang = l;
    document.getElementById('srLangHi').classList.toggle('active', l==='hi');
    document.getElementById('srLangEn').classList.toggle('active', l==='en');
    document.getElementById('srBrandTitle').textContent = tr().brandTitle;
    document.getElementById('srBrandSub').textContent = tr().brandSub;
    document.getElementById('srSidebarClose').setAttribute('aria-label', tr().closeMenu);
    document.getElementById('srHamburger').setAttribute('aria-label', tr().openMenu);
    document.documentElement.lang = l;
    buildNav();
    updateSidebarHead();
    updateSidebarOrgBox();
    renderCurrentPage();
  }
  document.getElementById('srLangHi').addEventListener('click', ()=>setLang('hi'));
  document.getElementById('srLangEn').addEventListener('click', ()=>setLang('en'));

  function buildNav(){
    navEl.innerHTML = pageKeys.map(p=>`<button class="sr-nav-item ${state.page===p?'active':''}" data-page="${p}">${tr().navIcons[p]} <span>${tr().nav[p]}</span></button>`).join('');
    navEl.querySelectorAll('.sr-nav-item').forEach(btn=>btn.addEventListener('click', ()=>goToPage(btn.getAttribute('data-page'))));
  }

  function renderCurrentPage(){
    pageTitleEl.textContent = tr().nav[state.page] || '';
    if(state.page==='dashboard') renderDashboard();
    else if(state.page==='members') renderMembers();
    else if(state.page==='attendance') drawAttendance();
    else if(state.page==='games') renderGames();
    else if(state.page==='subhashitam') renderSubhashitam();
    else if(state.page==='amritvachan') renderAmritVachan();
    else if(state.page==='ganvesh') renderGanvesh();
    else if(state.page==='pravas') renderPravas();
  }

  // ---------- Navigation ----------
  async function goToPage(p){
    state.page = p;
    navEl.querySelectorAll('.sr-nav-item').forEach(b=>b.classList.toggle('active', b.dataset.page===p));
    pageTitleEl.textContent = tr().nav[p] || '';
    closeMobileSidebar();
